{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@imperium/ai": ["../ai/src/index.ts"],
      "@imperium/database": ["../database/src/index.ts"]
    }
  },
  "include": ["src"]
}
