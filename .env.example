# База данных (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://imperium:imperium_dev@127.0.0.1:5432/imperium
DATABASE_URL_ADMIN=postgresql://postgres:@127.0.0.1:5432/postgres

# Redis (очереди миссий)
REDIS_URL=redis://127.0.0.1:6379

# Шифрование токенов интеграций (64 hex-символа = 32 байта).
# Сгенерировать: openssl rand -hex 32
ENCRYPTION_KEY=

# API
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Веб
VITE_API_URL=http://127.0.0.1:3101
