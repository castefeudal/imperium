# ── База данных (PostgreSQL 16 + pgvector) ──────────────
DATABASE_URL=postgresql://imperium:imperium_dev@127.0.0.1:5432/imperium
DATABASE_URL_ADMIN=postgresql://postgres:@127.0.0.1:5432/postgres

# ── Redis (очереди миссий/автоматизаций) ────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Шифрование токенов интеграций (AES-256-GCM) ────────
# Сгенерировать: openssl rand -hex 32
ENCRYPTION_KEY=

# ── API ─────────────────────────────────────────────────
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ── AI-провайдеры (опционально; без них работает demo/test-provider) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
AI_FAST_MODEL=gpt-4o-mini
AI_REASONING_MODEL=gpt-4o
AI_CODING_MODEL=gpt-4o
AI_VISION_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small

# ── Веб ─────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:3101
