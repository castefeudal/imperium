# ── База данных (PostgreSQL 16 + pgvector) ──────────────
DATABASE_URL=postgresql://imperium:imperium_dev@127.0.0.1:5432/imperium
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# ── Redis (очереди миссий/автоматизаций) ────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Шифрование токенов интеграций (AES-256-GCM) ────────
# Сгенерировать: openssl rand -hex 32
ENCRYPTION_KEY=

# ── API ─────────────────────────────────────────────────
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ── AI-провайдеры (опционально; без них работает встроенный тест-провайдер) ──
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ── Веб ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:3100
