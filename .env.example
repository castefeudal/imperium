# ── APP ──────────────────────────────────────────────
APP_NAME=IMPERIUM
APP_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
LOG_LEVEL=info

# ── DATABASE ─────────────────────────────────────────
DATABASE_URL=postgresql://imperium:imperium_dev@127.0.0.1:5432/imperium
DATABASE_POOL_MAX=10

# ── REDIS ────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── STORAGE (S3-compatible / MinIO) ──────────────────
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=imperium
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# ── AUTH / ENCRYPTION ────────────────────────────────
AUTH_SECRET=change-me-64-bytes-random-hex
ENCRYPTION_KEY=change-me-32-bytes-base64
SESSION_TTL_HOURS=720

# ── AI ───────────────────────────────────────────────
# Provider profiles: fast | reasoning | coding | vision | embedding | fallback
AI_PROVIDER=openai-compatible
AI_FAST_MODEL=gpt-4o-mini
AI_REASONING_MODEL=o3
AI_CODING_MODEL=gpt-4o
AI_VISION_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ── GOOGLE (Gmail / Calendar) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# ── GITHUB ───────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_APP_ID=

# ── TELEGRAM ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── TICKTICK ─────────────────────────────────────────
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=

# ── NOTION ───────────────────────────────────────────
NOTION_TOKEN=

# ── OBSERVABILITY ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
METRICS_ENABLED=true

# ── RUNNER (code execution sandbox) ──────────────────
RUNNER_ENABLED=false
RUNNER_IMAGE=imperium-runner:latest
RUNNER_TIMEOUT_SECONDS=120
RUNNER_MEMORY_LIMIT_MB=512
