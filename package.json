{
  "name": "imperium",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @imperium/database test:integration",
    "test:e2e": "pnpm --filter @imperium/web test:e2e",
    "db:migrate": "pnpm --filter @imperium/database migrate",
    "db:seed": "pnpm --filter @imperium/database seed",
    "db:reset": "pnpm --filter @imperium/database reset",
    "smoke": "node scripts/smoke.mjs"
  }
}
